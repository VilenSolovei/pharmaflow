{
  "name": "@pharmaflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "check": "tsc --noEmit",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "test:auth": "node --test test/auth.e2e.mjs",
    "db:seed": "npm run build && node dist/database/seed.js",
    "test:catalog": "node --test test/catalog.e2e.mjs",
    "test:cart": "node --test test/cart.e2e.mjs",
    "test:orders": "node --test test/orders.e2e.mjs",
    "test:processing": "node --test test/order-state.test.mjs test/order-processing.e2e.mjs",
    "admin:grant": "npm run build && node dist/admin/grant-admin.js",
    "test:account": "node --test test/account.e2e.mjs",
    "test:loyalty": "node --test test/pricing.test.mjs test/loyalty.e2e.mjs",
    "test:notifications": "node --test test/reminders.test.mjs test/notifications.e2e.mjs",
    "notifications:run": "node dist/notifications/run.js",
    "test:admin": "node --test test/catalog-admin.e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/event-emitter": "12.0.3",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/typeorm": "12.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12"
  }
}
